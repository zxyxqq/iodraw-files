apse"},"children":[{"data":{"id":"dn0k4lgafj40","created":1795230576423,"text":"栈溢出检测"},"children":[{"data":{"id":"dn0k57tzm740","created":1795230625140,"text":"高水位标记、栈保护"},"children":[]}]},{"data":{"id":"dn0k4llyghc0","created":1795230576765,"text":"断言 Assert"},"children":[{"data":{"id":"dn0k56kbye80","created":1795230622379,"text":"内核和驱动错误定位。"},"children":[]}]},{"data":{"id":"dn0k4lo7q7c0","created":1795230576902,"text":"看门狗"},"children":[{"data":{"id":"dn0k54dbvvk0","created":1795230617603,"text":"任务级喂狗，防跑飞。"},"children":[]}]},{"data":{"id":"dn0k4lqqdwo0","created":1795230577054,"text":"HardFault 分析"},"children":[{"data":{"id":"dn0k4zne2ts0","created":1795230607327,"text":"结合 PC、LR、栈帧定位"},"children":[]}]},{"data":{"id":"dn0k4lxe8y00","created":1795230577457,"text":"Trace/SystemView"},"children":[{"data":{"id":"dn0k5dw0o4g0","created":1795230638324,"text":"看任务切换、队列、中断时序"},"children":[]}]}]},{"data":{"id":"dn0kp0u1bfk0","created":1795232177189,"text":"寄存器","expandState":"collapse"},"children":[{"data":{"id":"dn0j3v3jhsg0","created":1795227697946,"text":"栈指针(SP)","expandState":"collapse"},"children":[{"data":{"id":"dn0j56v3zz40","created":1795227801921,"text":"SP 是 CPU 内部的一个寄存器，它保存的是当前栈顶的内存地址"},"children":[]},{"data":{"id":"dn0j42z12ow0","created":1795227715087,"text":"MSP(主栈指针\n)"},"children":[{"data":{"id":"dn0ja91glv40","created":1795228198480,"text":"异常/中断强制使用"},"children":[]},{"data":{"id":"dn0jb6np7uo0","created":1795228271658,"text":"复位后默认使用的栈指针"},"children":[]}]},{"data":{"id":"dn0j434djnk0","created":1795227715410,"text":"PSP（进程栈指针\n）"},"children":[{"data":{"id":"dn0jaxql2cg0","created":1795228252242,"text":"仅在线程模式（Thread Mode）可用。"},"children":[]},{"data":{"id":"dn0jb3iadow0","created":1795228264801,"text":"每个任务拥有独立的 PSP，实现任务栈隔离。"},"children":[]}]}]},{"data":{"id":"dn0j7sq2o6o0","created":1795228006234,"text":"PC（程序计数器）","expandState":"collapse"},"children":[{"data":{"id":"dn0je8pwuk00","created":1795228511238,"text":"CPU内部的一个专用寄存器，硬件寄存器"},"children":[]},{"data":{"id":"dn0je8xc8bs0","created":1795228511687,"text":"指示CPU下一条要取指/执行的指令在存储器中的地址"},"children":[]},{"data":{"id":"dn0je8zvwsg0","created":1795228511841,"text":"下一条要取指/执行的地址"},"children":[]}]},{"data":{"id":"dn0j7yul01s0","created":1795228019568,"text":"LR连接寄存器","expandState":"collapse"},"children":[{"data":{"id":"dn0jfev7uo80","created":1795228602984,"text":"保存子程序调用的返回地址，或者保存异常返回信息"},"children":[]},{"data":{"id":"dn0jg05eij40","created":1795228649312,"text":"调用发生时要返回的地址"},"children":[]}]}]},{"data":{"id":"dn3xd0ybv8w0","created":1795572591377,"text":"钩子函数HOOK","expandState":"collapse"},"children":[{"data":{"id":"dn3xfbhkcs00","created":1795572771037,"text":"定义"},"children":[{"data":{"id":"dn3xfgqhgd40","created":1795572782460,"text":" 内核在特定事件发生时自动调用的函数。"},"children":[]}]},{"data":{"id":"dn3xfscrjds0","created":1795572807752,"text":"种类","expandState":"expand"},"children":[{"data":{"id":"dn3xd73y25c0","created":1795572604778,"text":"空闲任务钩子"},"children":[{"data":{"id":"dn3xgf6ofmo0","created":1795572857450,"text":"空闲任务的循环中被调用"},"children":[{"data":{"id":"dn3xgkqv4080","created":1795572869554,"text":"低功耗"},"children":[]}]}]},{"data":{"id":"dn3xd78sts00","created":1795572605071,"text":"栈溢出钩子"},"children":[{"data":{"id":"dn3xio58yls0","created":1795573033682,"text":"栈溢出检查机制检测到某个任务的栈空间不足时被调用"},"children":[{"data":{"id":"dn3xiwyy0c00","created":1795573052892,"text":"栈溢出发生的第一时间捕获错误，便于调试，而不是等到内存被破坏导致系统行为异常后才去排查"},"children":[]}]}]},{"data":{"id":"dn3xd7bec800","created":1795572605228,"text":" 定时器 节拍钩子","font-style":"italic"},"children":[{"data":{"id":"dn3xgx746nc0","created":1795572896658,"text":"系统时钟节拍中断服务函数中被调用"},"children":[{"data":{"id":"dn3xhmjdcfk0","created":1795572951819,"text":"高精度计时、软件定时器"},"children":[]}]}]},{"data":{"id":"dn3xd7df9lk0","created":1795572605351,"text":" Malloc 失败钩子"},"children":[{"data":{"id":"dn3xhqk46d40","created":1795572960571,"text":"内核在调用 pvPortMalloc() 申请内存失败时被调用。"},"children":[{"data":{"id":"dn3xht4tldk0","created":1795572966176,"text":"系统内存耗尽时进行错误处理或记录"},"children":[]}]}]},{"data":{"id":"dn3xd7fg91k0","created":1795572605473,"text":"任务删除钩子"},"children":[{"data":{"id":"dn3xi4knle00","created":1795572991078,"text":"当一个任务被删除时被调用，可用于释放该任务关联的资源（如动态分配的内存、打开的外设等）。"},"children":[]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}