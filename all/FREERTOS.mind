,"created":1794809932372,"text":"队列"},"children":[{"data":{"id":"dn0jhb4t54g0","created":1795228751585,"text":"结构体"},"children":[]}]},{"data":{"id":"dmwf0sb8duo0","created":1794809932521,"text":"任务通知"},"children":[{"data":{"id":"dmwf82lt2zs0","created":1794810503478,"text":"1对1"},"children":[]},{"data":{"id":"dn0jicmqhs00","created":1795228833210,"text":"无等待列表"},"children":[]}]},{"data":{"id":"dmwf0sdswog0","created":1794809932677,"text":"事件组"},"children":[]},{"data":{"id":"dmwf0sg2j6g0","created":1794809932814,"text":"流/消息缓冲区"},"children":[{"data":{"id":"dn0jhr4yq6g0","created":1795228786423,"text":"无等待列表"},"children":[]}]}]},{"data":{"id":"dmwf3tzz1d40","created":1794810171287,"text":"任务状态"},"children":[{"data":{"id":"dmwf3zkpjh40","created":1794810183424,"text":"运行态"},"children":[{"data":{"id":"dmwf54f3ffs0","created":1794810272333,"text":"无列表","priority":null,"progress":null},"children":[]}]},{"data":{"id":"dmwf3zpmxfs0","created":1794810183722,"text":"就绪态"},"children":[{"data":{"id":"dmwf4qilh2g0","created":1794810242070,"text":"就绪态列表"},"children":[]}]},{"data":{"id":"dmwf4163ukw0","created":1794810186895,"text":"阻塞态"},"children":[{"data":{"id":"dmwf4rantx40","created":1794810243767,"text":"阻塞态列表"},"children":[]}]},{"data":{"id":"dmwf3zs233c0","created":1794810183869,"text":"挂起态"},"children":[{"data":{"id":"dmwf4rxzacg0","created":1794810245177,"text":"挂起态列表"},"children":[]}]}]},{"data":{"id":"dn0j3v3jhsg0","created":1795227697946,"text":"栈指针(SP)"},"children":[{"data":{"id":"dn0j56v3zz40","created":1795227801921,"text":"SP 是 CPU 内部的一个寄存器，它保存的是当前栈顶的内存地址"},"children":[]},{"data":{"id":"dn0j42z12ow0","created":1795227715087,"text":"MSP(主栈指针\n)"},"children":[{"data":{"id":"dn0ja91glv40","created":1795228198480,"text":"异常/中断强制使用"},"children":[]},{"data":{"id":"dn0jb6np7uo0","created":1795228271658,"text":"复位后默认使用的栈指针"},"children":[]}]},{"data":{"id":"dn0j434djnk0","created":1795227715410,"text":"PSP（进程栈指针\n）"},"children":[{"data":{"id":"dn0jaxql2cg0","created":1795228252242,"text":"仅在线程模式（Thread Mode）可用。"},"children":[]},{"data":{"id":"dn0jb3iadow0","created":1795228264801,"text":"每个任务拥有独立的 PSP，实现任务栈隔离。"},"children":[]}]}]},{"data":{"id":"dn0j7sq2o6o0","created":1795228006234,"text":"PC（程序计数器）","expandState":"expand"},"children":[{"data":{"id":"dn0je8pwuk00","created":1795228511238,"text":"CPU内部的一个专用寄存器，硬件寄存器"},"children":[]},{"data":{"id":"dn0je8xc8bs0","created":1795228511687,"text":"指示CPU下一条要取指/执行的指令在存储器中的地址"},"children":[]},{"data":{"id":"dn0je8zvwsg0","created":1795228511841,"text":"下一条要取指/执行的地址"},"children":[]}]},{"data":{"id":"dn0j7yul01s0","created":1795228019568,"text":"LR连接寄存器"},"children":[{"data":{"id":"dn0jfev7uo80","created":1795228602984,"text":"保存子程序调用的返回地址，或者保存异常返回信息"},"children":[]},{"data":{"id":"dn0jg05eij40","created":1795228649312,"text":"调用发生时要返回的地址"},"children":[]}]},{"data":{"id":"dn0jjqt4qmo0","created":1795228942436,"text":"死锁"},"children":[]},{"data":{"id":"dn0jkj3v0b40","created":1795229004034,"text":"分支主题"},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}