{"root":{"data":{"id":"dmwez6p3zgo0","created":1794809807107,"text":"FREERTOS"},"children":[{"data":{"id":"dmwezg3jgmw0","created":1794809827571,"text":"进程"},"children":[{"data":{"id":"dmwf3cocdd40","created":1794810133578,"text":"资源分配与保护的基本单位"},"children":[]}]},{"data":{"id":"dmwezg8393k0","created":1794809827846,"text":"线程(任务)"},"children":[{"data":{"id":"dmwf38d9yi00","created":1794810124202,"text":"CPU调度基本单位"},"children":[]}]},{"data":{"id":"dmwezlqyx4g0","created":1794809839871,"text":"调度器"},"children":[]},{"data":{"id":"dmwezptyf680","created":1794809848759,"text":"pendsv"},"children":[{"data":{"id":"dmwf2i2f5go0","created":1794810066949,"text":"Cortex-M用于触发上下文切换的异常机制"},"children":[]}]},{"data":{"id":"dmwezq3f5x40","created":1794809849331,"text":"通信机制"},"children":[{"data":{"id":"dmwf0rldvm00","created":1794809930959,"text":"信号量"},"children":[{"data":{"id":"dmwf668tcf40","created":1794810354671,"text":"二值/计数型"},"children":[{"data":{"id":"dmwf715bzzk0","created":1794810421941,"text":"二值:同步，任务通知"},"children":[]},{"data":{"id":"dmwf79y8vj40","created":1794810441103,"text":"计数:资源计数"},"children":[]}]}]},{"data":{"id":"dmwf0s6321s0","created":1794809932210,"text":"互斥量"},"children":[{"data":{"id":"dmwf7fzyycg0","created":1794810454268,"text":"优先级反转"},"children":[{"data":{"id":"dmwf7q2dzso0","created":1794810476182,"text":"优先级继承"},"children":[]}]}]},{"data":{"id":"dmwf0s8rgyo0","created":1794809932372,"text":"队列"},"children":[]},{"data":{"id":"dmwf0sb8duo0","created":1794809932521,"text":"任务通知"},"children":[{"data":{"id":"dmwf82lt2zs0","created":1794810503478,"text":"1对1"},"children":[]}]},{"data":{"id":"dmwf0sdswog0","created":1794809932677,"text":"事件组"},"children":[]},{"data":{"id":"dmwf0sg2j6g0","created":1794809932814,"text":"流/消息缓冲区"},"children":[]}]},{"data":{"id":"dmwf3tzz1d40","created":1794810171287,"text":"任务状态"},"children":[{"data":{"id":"dmwf3zkpjh40","created":1794810183424,"text":"运行态"},"children":[{"data":{"id":"dmwf54f3ffs0","created":1794810272333,"text":"无列表","priority":null,"progress":null},"children":[]}]},{"data":{"id":"dmwf3zpmxfs0","created":1794810183722,"text":"就绪态"},"children":[{"data":{"id":"dmwf4qilh2g0","created":1794810242070,"text":"就绪态列表"},"children":[]}]},{"data":{"id":"dmwf4163ukw0","created":1794810186895,"text":"阻塞态"},"children":[{"data":{"id":"dmwf4rantx40","created":1794810243767,"text":"阻塞态列表"},"children":[]}]},{"data":{"id":"dmwf3zs233c0","created":1794810183869,"text":"挂起态"},"children":[{"data":{"id":"dmwf4rxzacg0","created":1794810245177,"text":"挂起态列表"},"children":[]}]}]},{"data":{"id":"dn0j3v3jhsg0","created":1795227697946,"text":"栈指针(SP)"},"children":[{"data":{"id":"dn0j56v3zz40","created":1795227801921,"text":"SP 是 CPU 内部的一个寄存器，它保存的是当前栈顶的内存地址"},"children":[]},{"data":{"id":"dn0j42z12ow0","created":1795227715087,"text":"MSP(主栈指针\n)"},"children":[{"data":{"id":"dn0ja91glv40","created":1795228198480,"text":"异常/中断强制使用"},"children":[]},{"data":{"id":"dn0jb6np7uo0","created":1795228271658,"text":"复位后默认使用的栈指针"},"children":[]}]},{"data":{"id":"dn0j434djnk0","created":1795227715410,"text":"PSP（进程栈指针\n）"},"children":[{"data":{"id":"dn0jaxql2cg0","created":1795228252242,"text":"仅在线程模式（Thread Mode）可用。"},"children":[]},{"data":{"id":"dn0jb3iadow0","created":1795228264801,"text":"每个任务拥有独立的 PSP，实现任务栈隔离。"},"children":[]}]}]},{"data":{"id":"dn0j7sq2o6o0","created":1795228006234,"text":"PC（程序计数器）"},"children":[]},{"data":{"id":"dn0j7yul01s0","created":1795228019568,"text":"LR连接寄存器"},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}